general {
    colors = true
    interval = 5
    color_good = "#65d6d0"
    color_degraded = "#d8b56a"
    color_bad = "#d87979"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"

wireless _first_ {
    format_up = " ◇ %quality "
    format_down = " ◇ -- "
}

ethernet _first_ {
    format_up = " ◆ %speed "
    format_down = " ◆ -- "
}

cpu_usage {
    format = " ◈ CPU %usage "
}

memory {
    format = " ◇ MEM %used/%total "
}

disk "/" {
    format = " ✦ / %free "
}

tztime local {
    format = " ❖ %Y-%m-%d %H:%M "
}
